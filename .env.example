# Copy this file to .env and fill in your own values.
# Get free paper-trading keys from the Alpaca dashboard.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
# Port on your machine for connecting to Postgres (change if 5433 is taken)
POSTGRES_HOST_PORT=5433
MB_ENCRYPTION_SECRET_KEY=paste_the_generated_value_here
# Port on your machine for opening Metabase (change if 3001 is taken)
METABASE_HOST_PORT=3001
